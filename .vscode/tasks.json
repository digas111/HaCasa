{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docs: Start Jekyll",
      "type": "shell",
      "command": "/opt/homebrew/opt/ruby@3.3/bin/bundle",
      "args": [
        "exec",
        "jekyll",
        "serve",
        "--host",
        "127.0.0.1",
        "--port",
        "4000"
      ],
      "options": {
        "cwd": "${workspaceFolder}/docs"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "HA: Prepare Fixture",
      "type": "npm",
      "script": "test:ha:prepare",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "HA: Start Home Assistant",
      "type": "npm",
      "script": "test:ha:up",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "HA: Wait For Home Assistant",
      "type": "npm",
      "script": "test:ha:wait",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "HA: Ensure Test Account",
      "type": "npm",
      "script": "test:ha:onboard",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "HA: Run Smoke Tests",
      "type": "npm",
      "script": "test:ha",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "HA: Start Dashboard For Visual Check",
      "type": "shell",
      "command": "node",
      "args": [
        "-e",
        "console.log('Home Assistant is ready: http://127.0.0.1:8123/hacasa-dashboard/home')"
      ],
      "dependsOrder": "sequence",
      "dependsOn": [
        "HA: Prepare Fixture",
        "HA: Start Home Assistant",
        "HA: Wait For Home Assistant",
        "HA: Ensure Test Account"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "detail": "Starts Home Assistant at http://127.0.0.1:8123/hacasa-dashboard/home"
    },
    {
      "label": "HA: Refresh Dashboard For Visual Check",
      "type": "shell",
      "command": "node",
      "args": [
        "-e",
        "console.log('Home Assistant refreshed: http://127.0.0.1:8123/hacasa-dashboard/home')"
      ],
      "dependsOrder": "sequence",
      "dependsOn": [
        "HA: Stop Home Assistant",
        "HA: Prepare Fixture",
        "HA: Start Home Assistant",
        "HA: Wait For Home Assistant",
        "HA: Ensure Test Account"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "detail": "Rebuilds the dashboard fixture, restarts Home Assistant, and prints the dashboard URL."
    },
    {
      "label": "HA: Stop Home Assistant",
      "type": "npm",
      "script": "test:ha:down",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
