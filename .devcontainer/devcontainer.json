{
  "name": "HaCasa",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    }
  },
  "privileged": true,
  "remoteUser": "node",
  "containerEnv": {
    "TZ": "Europe/Lisbon"
  },
  "mounts": [
    "source=hacasa-dind-var-lib-docker,target=/var/lib/docker,type=volume"
  ],
  "postCreateCommand": "npm run setup:devcontainer",
  "forwardPorts": [8123],
  "portsAttributes": {
    "8123": {
      "label": "Home Assistant test harness",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "ms-playwright.playwright",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "files.trimTrailingWhitespace": true
      }
    }
  }
}
